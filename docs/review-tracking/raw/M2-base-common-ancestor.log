+-@dec(3)
+-@dece(2)
+-@inject_locals(abcd=1234)
+-@dece(1)
+-@dec(2)
+-@dece(0)
+-@dec(1)
+-def checkme(blah=2):
+-    print("abcd:", abcd)
+-    print("super", super)
+-
+-
+-if __name__ == "__main__":
+-    checkme()
