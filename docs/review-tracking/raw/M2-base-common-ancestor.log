   416	# Legacy alias — prefer ``get_args_at_base``. Same object, so it shares the cache.
   417	get_resolved_typevars_for_base = get_args_at_base
   418	
   419	
   420	def get_typevar_value(
   421	    cls: type | GenericAlias,
   422	    target_base: type,
   423	    typevar: TypeVar,
   424	    return_bound_as_fallback: bool = False,
   425	) -> Any:
   426	    """Resolve a single, named typevar of ``target_base`` as seen from ``cls``.
   427	
   428	    Where :func:`get_args_at_base` returns all of ``target_base``'s args
   429	    positionally, this looks one up by TypeVar identity. Returns the resolved
   430	    value (a type, a generic alias, or ``typing.NoDefault`` when the typevar is
   431	    unspecialized and has no default).
   432	
   433	    This is the untyped escape hatch; for a statically-typed surface, see
   434	    :class:`paramsight.TypeVarValue`.
   435	    """
   436	    params = list(get_parameters(target_base))
   437	    try:
   438	        idx = params.index(typevar)
   439	    except ValueError:
   440	        raise ValueError(
   441	            f"{typevar!r} is not a typevar of {target_base!r}; "
   442	            f"its typevars are {params}"
   443	        ) from None
   444	    return get_args_at_base(cls, target_base, return_bound_as_fallback)[idx]

