    89	    # hook is the user's and we must run it for every subclass -- the previous
    90	    # code called ``super(owner, cls)`` unconditionally and silently ate it.
    91	    # We invoke the captured original (the user's hook); it propagates up the
    92	    # chain itself via its own ``super().__init_subclass__()``, just like native
    93	    # Python. If ``owner`` has no hook of its own there is nothing to run, so we
    94	    # fall back to ``super(owner, cls)`` to continue the cooperative chain --
    95	    # which, walking ``cls``'s MRO, reaches siblings (e.g. ``Generic`` /
    96	    # pydantic's machinery that set ``__parameters__``) that ``owner``'s own MRO
    97	    # does not include.
    98	    owner_defines_hook = "__init_subclass__" in vars(owner)
    99	
   100	    def _patched_init_subclass(cls, *a, **kw):
