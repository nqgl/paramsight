   107	            # a non-descriptor callable (e.g. a decorator that returns a callable
   108	            # instance). Bind through the descriptor protocol when present; else
   109	            # call it directly, mirroring native class creation -- which invokes
   110	            # a non-descriptor ``__init_subclass__`` unbound rather than raising.
   111	            if hasattr(_orig_init_subclass, "__get__"):
   112	                _orig_init_subclass.__get__(None, cls)(*a, **kw)
   113	            else:
   114	                _orig_init_subclass(*a, **kw)
   115	        else:
   116	            super(owner, cls).__init_subclass__(*a, **kw)
