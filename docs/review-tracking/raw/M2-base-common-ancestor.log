+    def __getattr__(self, name):
+        got = getattr(self._sup, name)
+        if hasattr(got, "__func__"):
+            if hasattr(got.__func__, _TA_REF_ATTR):
+                ta = getattr(got.__func__, _TA_REF_ATTR)
+                return ta.__get__(None, self.obj)
+        return got
