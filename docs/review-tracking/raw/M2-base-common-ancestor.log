+        copy.deepcopy(inst),
+        pickle.loads(pickle.dumps(inst)),
+    ):
+        assert revived.get_type() == (int,)
+        assert (revived.a, revived.b) == (1, 2)
+        assert isinstance(revived, SwapPair)
+
