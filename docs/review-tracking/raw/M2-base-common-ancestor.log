--- class_swap line nums ---
     1	"""``class_swap`` strategy: carry parametrization via a synthetic subclass.
     2	
     3	``Child[int](...)`` produces an instance whose ``__class__`` is swapped to a
     4	cached, per-parametrization ``__slots__ = ()`` subclass of ``Child`` carrying
     5	``_paramsight_alias = Child[int]``. Because the synthetic adds no slots, it is
     6	layout-compatible with the origin, so the swap works on slotted / frozen
     7	instances. ``isinstance(inst, Child)`` stays ``True``; ``type(inst) is Child``
     8	becomes ``False`` (the documented trade-off of this strategy).
     9	
    10	It survives ``attrs.evolve`` / ``copy`` / ``deepcopy`` (those rebuild via
    11	``type(inst)``, which is the synthetic) and ``pickle`` (via the ``__reduce__``
    12	installed on the synthetic, which reconstructs the origin instance and re-swaps
    13	its ``__class__``; state save/restore is delegated to the normal machinery).
    14	"""
    15	
    16	import threading
    17	
    18	# (origin, args) -> synthetic subclass. The alias that keys a parametrization
    19	# is itself cached for the process's lifetime, so this never frees -- one small
    20	# type object per distinct parametrization actually instantiated.
    21	_synth_cache: dict[tuple, type] = {}
    22	
    23	# Set while we call ``type(...)`` to build a synthetic, so paramsight's patched
    24	# ``__init_subclass__`` can skip it (a synthetic is an implementation detail and
    25	# must not trigger user/base ``__init_subclass__`` hooks or re-install proxies).
    26	_creating = threading.local()
    27	
    28	
    29	def is_creating_synth() -> bool:
    30	    return getattr(_creating, "flag", False)
    31	
    32	
    33	def _args_for_getitem(args: tuple):
    34	    # Mirror ``typing._GenericAlias.__reduce__``: a 1-tuple of a non-tuple
    35	    # subscripts as a scalar (``Box[int]`` not ``Box[(int,)]``).
    36	    if len(args) == 1 and not isinstance(args[0], tuple):
    37	        return args[0]
    38	    return args
    39	
    40	
    41	def _get_or_make(origin: type, args: tuple) -> type:
    42	    key = (origin, args)
    43	    cached = _synth_cache.get(key)
    44	    if cached is not None:
    45	        return cached
    46	    # origin has paramsight's patched __class_getitem__ (-> _GAProxy); the
    47	    # checker can't model that runtime subscriptability.
    48	    alias = origin[_args_for_getitem(args)]  # pyright: ignore[reportIndexIssue]
    49	    ns = {
    50	        "__slots__": (),
    51	        "_paramsight_alias": alias,
    52	        "__module__": getattr(origin, "__module__", None),
    53	        "__qualname__": getattr(origin, "__qualname__", origin.__name__),
    54	        "__reduce__": _synth_reduce,
    55	    }
    56	    _creating.flag = True
    57	    try:
    58	        synth = type(origin)(origin.__name__, (origin,), ns)
    59	    finally:
    60	        _creating.flag = False
    61	    _synth_cache[key] = synth
    62	    return synth
    63	
    64	
    65	def get_synth(alias) -> type:
    66	    """The synthetic subclass for ``alias`` (a ``_GAProxy``)."""
    67	    return _get_or_make(alias.__origin__, alias.__args__)
    68	
    69	
    70	def _synth_new(origin: type, args: tuple, newargs: tuple = (), newkwargs=None):
    71	    # Honor a custom / argument-taking ``__new__`` (captured via
    72	    # ``__getnewargs_ex__`` / ``__getnewargs__`` in ``_synth_reduce``) so classes
    73	    # that need construction arguments still round-trip through copy/pickle.
    74	    # ``origin.__new__(origin, ...)`` is valid for an arbitrary class at runtime;
    75	    # typeshed's __new__ overloads can't express it.
    76	    obj = origin.__new__(origin, *newargs, **(newkwargs or {}))  # pyright: ignore[reportCallIssue]
    77	    object.__setattr__(obj, "__class__", _get_or_make(origin, args))
    78	    return obj
    79	
    80	
    81	def _synth_reduce(self):
    82	    # 4-arg ``(callable, args, state)``: pickle calls ``_synth_new`` then applies
    83	    # ``state`` via the instance's normal ``__setstate__`` (or the default
    84	    # slotted-state handling) -- so we don't reimplement state I/O. Forward any
    85	    # ``__getnewargs_ex__`` / ``__getnewargs__`` so an arg-taking ``__new__`` is
    86	    # reconstructed with its required arguments rather than failing on a bare
    87	    # ``origin.__new__(origin)``.
    88	    alias = type(self)._paramsight_alias
    89	    newargs: tuple = ()
    90	    newkwargs = None
    91	    getnewargs_ex = getattr(self, "__getnewargs_ex__", None)
    92	    if getnewargs_ex is not None:
    93	        newargs, newkwargs = getnewargs_ex()
    94	    else:
    95	        getnewargs = getattr(self, "__getnewargs__", None)
    96	        if getnewargs is not None:
    97	            newargs = getnewargs()
    98	    getstate = getattr(self, "__getstate__", None)
    99	    state = getstate() if getstate is not None else self.__dict__
   100	    return (_synth_new, (alias.__origin__, alias.__args__, newargs, newkwargs), state)
   101	
