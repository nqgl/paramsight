   321	    if subscripted and len(args) >= len(params) - 1:
   322	        absorbed = tuple(
   323	            _substitute_typevars(a, subs) for a in args[tvt_idx : tvt_idx + n_absorbed]
   324	        )
   325	        if any(_is_unpack(a) or a is _NODEFAULT for a in absorbed):
   326	            # An absorbed ``*Us`` whose TypeVarTuple stayed unbound (or a NoDefault
   327	            # member) leaves the run's length indeterminate, so the whole binding
   328	            # is unresolved -- not a concrete tuple that merely contains the hole.
   329	            subs[tvt] = _NODEFAULT
   330	        else:
   331	            subs[tvt] = absorbed
   332	    else:
   333	        # Bare (unsubscripted) class, or too few args: ``*Ts`` is unspecified, so
   334	        # treat it as unfilled (-> unresolved) rather than an empty binding,
   335	        # matching how a bare ``C[T]`` leaves ``T`` unresolved.
   336	        bind_unfilled(tvt)
   337	    for j in range(n_suffix):
   338	        p = params[tvt_idx + 1 + j]
   339	        if not bindable(p):
   340	            continue
   341	        arg_idx = tvt_idx + n_absorbed + j
   342	        bind_positional(p, args[arg_idx]) if arg_idx < len(args) else bind_unfilled(p)
   343	    return subs
   344	
   345	
   346	def _resolve(
   347	    node: Any,
   348	    target_base: type,
   349	    parent_subs: dict[Any, Any],
   350	    return_bound_as_fallback: bool,
   351	) -> tuple[Any, ...] | None:
   352	    """DFS through ``node``'s inheritance hierarchy looking for ``target_base``.
   353	
   354	    ``parent_subs`` is the substitution map accumulated from outer levels and
   355	    is applied to ``node``'s args before computing this level's own
   356	    substitution map. When ``origin`` matches ``target_base`` we read the
   357	    target's own typevars out of the freshly-built map.
   358	    """
   359	    if is_generic_alias(node):
   360	        origin = get_origin_robust(node)
   361	        if origin is None:
   362	            return None
   363	        args = _subst_args(get_args_robust(node), parent_subs)
   364	        subscripted = True
   365	    elif isinstance(node, type):
   366	        origin = node
   367	        args = ()
   368	        subscripted = False
   369	    else:
   370	        return None
   371	
   372	    subs = _build_subs(origin, args, return_bound_as_fallback, subscripted)
   373	
   374	    if origin is target_base:
   375	        params = get_parameters(target_base)
   376	        # Builtin generics (list, dict, tuple, collections.abc.*, ...) don't
   377	        # expose their type parameters via __type_params__/__parameters__, so
   378	        # ``params`` is empty even though we arrived via e.g. ``list[list[T]]``.
   379	        # In that case fall back to the (already-substituted) args we walked to.
   380	        if not params and args:
   381	            return args
   382	        # ``subs.get(p, p)`` (not gated on ``_is_typevar``) so ``*Ts`` / ``**P``
   383	        # params resolve to their bound value too.
   384	        return tuple(subs.get(p, p) for p in params)
   385	
   386	    for base in get_original_bases(origin):
   387	        base_origin = get_origin_robust(base) if is_generic_alias(base) else base
   388	        if base_origin is typing.Generic:
   389	            continue
   390	        result = _resolve(base, target_base, subs, return_bound_as_fallback)
   391	        if result is not None:
   392	            return result
   393	    return None
   394	
   395	
   396	@cache
   397	def get_args_at_base(
   398	    cls: type | GenericAlias,
   399	    target_base: type,
   400	    return_bound_as_fallback: bool = False,
   401	) -> tuple[type | GenericAlias | None, ...]:
   402	    """Resolve ``target_base``'s type parameters as seen from ``cls``.
   403	
   404	    Like :func:`typing.get_args`, but evaluated at an ancestor base anywhere
   405	    in ``cls``'s inheritance hierarchy rather than only at the immediate
   406	    generic alias. Returns one entry per typevar of ``target_base``.
   407	    """
   408	    result = _resolve(cls, target_base, {}, return_bound_as_fallback)
   409	    if result is None:
   410	        raise ValueError(
   411	            f"failed to locate target base {target_base!r} in hierarchy of {cls!r}"
   412	        )
   413	    return result
   414	
