+def test_class_swap_suppresses_init_subclass_for_synthetics():
+    calls = []
+
+    class Hook:
+        def __init_subclass__(cls, **kw):
+            super().__init_subclass__(**kw)
+            calls.append(cls.__name__)
+
+    @uses_class_swap
+    @define
