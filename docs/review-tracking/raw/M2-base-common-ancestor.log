   128	        f"__slots__) and has no storage for ``__orig_class__``. The instance "
   129	        f"can't carry its parametrization, so the alias is unrecoverable -- "
   130	        f"silently falling back to the unparametrized class would yield "
   131	        f"``NoDefault`` for the typevars, which is almost certainly a bug. "
   132	        f"Opt in with one of paramsight.slotted_strategies:\n\n"
   133	        f"  from paramsight.slotted_strategies import (\n"
   134	        f"      add_field, uses_class_swap, uses_side_table)\n\n"
   135	        f"  # 1. Real ``__orig_class__`` field; survives "
   136	        f"attrs.evolve / copy / pickle.\n"
   137	        f"  #    @add_field must sit *below* @define / @dataclass -- it runs\n"
   138	        f"  #    first, so the field exists before they scan the body.\n"
   139	        f"  @define\n"
   140	        f"  @add_field\n"
   141	        f"  class {o}[T]:\n"
   142	        f"      ...\n\n"
   143	        f"  # 2. Synthetic-subclass swap; no field pollution; survives\n"
   144	        f"  #    evolve / copy / pickle. Trade-off: ``type(inst) is {o}``\n"
   145	        f"  #    becomes False (``isinstance`` still works).\n"
   146	        f"  @uses_class_swap\n"
   147	        f"  @define\n"
   148	        f"  class {o}[T]:\n"
   149	        f"      ...\n\n"
   150	        f"  # 3. Out-of-band table; no field pollution; does NOT survive\n"
   151	        f"  #    evolve / copy / pickle; needs weakref-able instances.\n"
   152	        f"  @uses_side_table\n"
   153	        f"  @define\n"
