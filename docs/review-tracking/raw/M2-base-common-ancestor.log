+
+    calls.clear()
+    # Building synthetics for these parametrizations must NOT fire Hook's
+    # __init_subclass__ (a synthetic is an implementation detail).
+    Child[int](x=1).f()
+    Child[str](x=2).f()
+    assert calls == []
