+class wsuper:  # noqa: N801
+    def __init__(self, t: Any = None, obj: Any = None):
+        if isinstance(obj, _GAProxy):
+            orig = obj.__origin__
+        else:
+            orig = obj
+        self._sup = super(t, orig)
+        self.obj = obj
