+class _TakesAlias[T, **P, R](classmethod):
+    def __init__(self, func: Callable[Concatenate[type[T], P], R]):
+        assert not isinstance(func, classmethod)
+        setattr(func, _TA_REF_ATTR, self)
+        super().__init__(func)
