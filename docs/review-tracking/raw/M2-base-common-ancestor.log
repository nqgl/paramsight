   178	class _TakesAlias[T, **P, R](classmethod):
   179	    def __init__(self, func: Callable[Concatenate[type[T], P], R]):
   180	        assert not isinstance(func, classmethod)
   181	        setattr(func, _TA_REF_ATTR, self)
   182	        super().__init__(func)
   183	
   184	    def __set_name__(self, owner, name):
   185	        self.name = name
   186	        _install_ga_proxy(owner)
   187	
   188	    def __get__(self, instance, owner=None) -> Callable[P, R]:
   189	        if instance is not None:
   190	            orig = get_orig_class(instance)
   191	            if orig is not None:
   192	                owner = orig
   193	            else:
   194	                cls = type(instance)
   195	                # No alias recovered. Raise only if losing the alias actually
   196	                # loses information: ``cls`` must still have *free* typevars.
   197	                # A non-generic class, or a concrete subclass that already
   198	                # binds the base's typevars via its MRO (``Concrete(Base[int])``)
   199	                # resolves fine straight from ``type(instance)`` -- no instance
   200	                # alias is needed. When ``cls`` does have free typevars and is
   201	                # slotted-without-storage and without an opt-in strategy,
   202	                # silently returning ``NoDefault`` for them would mask a real
   203	                # bug, so raise.
   204	                if (
   205	                    get_parameters(cls)
   206	                    and not _has_orig_class_storage(cls)
   207	                    and _slot_strategy(cls) is None
   208	                ):
   209	                    _raise_slotted_instance_without_storage(self.name, cls)
   210	                if owner is None:
   211	                    owner = cls
   212	        return super().__get__(instance, owner)
