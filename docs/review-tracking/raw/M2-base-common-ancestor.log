+-def dec(n):
+-    def decin(fn):
+-        if hasattr(fn, "_dece"):
+-            print("wrappingdece:", fn._dece)
+-
+-        @wraps(fn)
+-        def wrapped(*a, **k):
+-            print(f"dec{n}", fn)
