   103	def uses_class_swap(cls: type) -> type:
   104	    """Class decorator: track parametrization by swapping each instance's
   105	    ``__class__`` to a cached per-parametrization synthetic subclass.
   106	
   107	    No field pollution; survives ``attrs.evolve`` / ``copy`` / ``pickle``.
   108	    Trade-off: ``type(inst) is Cls`` becomes ``False`` (``isinstance`` still
   109	    works). Equivalent to ``_paramsight_slots = "class_swap"`` in the class
