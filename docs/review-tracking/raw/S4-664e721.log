TYPE_PAIR_STRAT = st.tuples(TYPE_STRAT, TYPE_STRAT)

DEFAULT_SETTINGS = settings(max_examples=12, deadline=None)

# ---------------------------------------------------------------------------
# TypeVars for old-style generics
# ---------------------------------------------------------------------------

T = TypeVar("T")
T1 = TypeVar("T1")
T2 = TypeVar("T2")

