    _is_typevar,
    get_args_robust,
    get_origin_robust,
    get_parameters,
    is_generic_alias,
)

_NODEFAULT = typing.NoDefault


def _substitute_typevars(value: Any, subs: dict[TypeVar, Any]) -> Any:
    """Recursively substitute typevars inside a type or generic alias."""
    if value is None:
        return None
    if _is_typevar(value):
        return subs.get(value, value)
