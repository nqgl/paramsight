   120	def is_generic_alias(cls: type | GenericAlias) -> TypeGuard[GenericAlias]:
   121	    if _is_pydantic(cls):
   122	        if not hasattr(cls, "__pydantic_generic_metadata__"):
   123	            return False
   124	        return cls.__pydantic_generic_metadata__["origin"] is not None
   125	    if isinstance(cls, typing._GenericAlias):  # type: ignore
   126	        return True
   127	    elif isinstance(cls, GenericAlias):
   128	        return True
   129	    return False
