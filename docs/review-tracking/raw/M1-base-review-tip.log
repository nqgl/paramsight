   228	
   229	def _build_subs(
   230	    origin: type,
   231	    args: tuple[Any, ...],
   232	    return_bound_as_fallback: bool,
   233	    subscripted: bool,
   234	) -> dict[Any, Any]:
   235	    """Bind ``origin``'s type parameters to positional args, defaults, or (when
   236	    requested) bounds. Parameters with no resolution map to NoDefault so that
   237	    they propagate as the unresolved sentinel through nested aliases.
   238	
   239	    A ``TypeVarTuple`` (``*Ts``) is variadic: it absorbs the *middle* args, with
   240	    the ordinary parameters before and after it binding around the absorbed run
   241	    (``class C[T, *Ts, U]`` with ``C[int, str, bytes, float]`` gives ``T=int``,
   242	    ``Ts=(str, bytes)``, ``U=float``). ``ParamSpec`` binds positionally like an
   243	    ordinary parameter, to a single parameter-list arg.
   244	
   245	    ``subscripted`` says whether we arrived via a subscription (``origin[...]``,
   246	    including an explicitly empty ``origin[()]``) rather than a bare, unspecialized
   247	    class. It only matters for a TypeVarTuple, which can legitimately bind to zero
   248	    types: ``C[()]`` makes ``*Ts`` empty, but bare ``C`` leaves it *unresolved*.
   249	    """
   250	    subs: dict[Any, Any] = {}
   251	    params = list(get_parameters(origin))
   252	
   253	    def bind_positional(p: Any, arg: Any) -> None:
   254	        # A ParamSpec's arg is a *parameter list*, not an ordinary type form, so it
   255	        # needs its own normalization (``C[int, ...]`` shorthand -> ``(int,)``;
   256	        # substitute the members of a ``[T]``-style binding).
   257	        if _is_paramspec(p):
   258	            subs[p] = _normalize_paramspec_arg(arg, subs)
   259	            return
   260	        # Resolve the arg against bindings so far. Usually a no-op, but a PEP 696
   261	        # default Python auto-filled into ``__args__`` arrives raw: as the
   262	        # *unsubstituted* typevar (``C[int]`` on ``class C[T, U = T]`` yields args
   263	        # ``(int, T)``, so ``T`` must resolve to ``int``) or as a raw value default
   264	        # (``U = None`` -> ``(int, None)``; ``U = "Foo"`` -> ``(int, "Foo")``).
   265	        # Explicit args are already normalized by subscription, but auto-filled
   266	        # ones are not -- so coerce first, exactly like the default branch, so
   267	        # ``C[int]`` and ``C[int, <default>]`` agree (``None`` -> ``NoneType``,
   268	        # ``"Foo"`` -> ``ForwardRef``). ``coerce_to_type_form`` is a no-op on
   269	        # types/aliases/typevars, so the ``U = T`` case still resolves.
   270	        subs[p] = _substitute_typevars(coerce_to_type_form(arg), subs)
   271	
   272	    def bind_unfilled(p: Any) -> None:
   273	        # No positional arg: fall back to default, then (optionally) bound, then
   274	        # the unresolved sentinel.
   275	        default = _get_typevar_default(p)
   276	        if default is not _NODEFAULT:
   277	            if _is_typevartuple(p):
   278	                # A TypeVarTuple's default is an unpacked tuple (``*Ts =
   279	                # *tuple[int, str]``); bind its fixed members so it expands like an
   280	                # absorbed arg run. A non-fixed default (``*tuple[int, ...]``) can't
   281	                # be expanded that way, so leave it unresolved rather than corrupt.
   282	                members = _typevartuple_default_members(default, subs)
   283	                subs[p] = members if members is not None else _NODEFAULT
   284	                return
   285	            # Normalize the default the way subscription normalizes an explicit
   286	            # arg (``None`` -> ``NoneType``, ``"Foo"`` -> ``ForwardRef('Foo')``),
   287	            # then resolve any typevars it references against the bindings so far.
   288	            # Coerce *before* substituting: ``_substitute_typevars`` passes
   289	            # ``None`` straight through, so ``None`` must already be ``NoneType``.
   290	            subs[p] = _substitute_typevars(coerce_to_type_form(default), subs)
   291	            return
   292	        if return_bound_as_fallback:
   293	            bound = getattr(p, "__bound__", None)
   294	            if bound is not None:
   295	                subs[p] = _substitute_typevars(coerce_to_type_form(bound), subs)
   296	                return
   297	        subs[p] = _NODEFAULT
   298	
   299	    def bindable(p: Any) -> bool:
   300	        return _is_typevar(p) or _is_paramspec(p)
   301	
   302	    tvt_idx = next((i for i, p in enumerate(params) if _is_typevartuple(p)), None)
   303	
   304	    if tvt_idx is None:
   305	        for i, p in enumerate(params):
   306	            if not bindable(p):
   307	                continue
   308	            bind_positional(p, args[i]) if i < len(args) else bind_unfilled(p)
   309	        return subs
   310	
   311	    # ``*Ts`` present: the ordinary params before it bind to the leading args, the
   312	    # ones after it to the trailing args, and it absorbs whatever is left between.
   313	    n_suffix = len(params) - tvt_idx - 1
   314	    n_absorbed = max(0, len(args) - (len(params) - 1))
   315	    for i in range(tvt_idx):
   316	        if bindable(params[i]):
   317	            bind_positional(params[i], args[i]) if i < len(args) else bind_unfilled(
   318	                params[i]
   319	            )
   320	    tvt = params[tvt_idx]
   321	    if subscripted and len(args) >= len(params) - 1:
   322	        absorbed = tuple(
   323	            _substitute_typevars(a, subs) for a in args[tvt_idx : tvt_idx + n_absorbed]
   324	        )
   325	        if any(_is_unpack(a) or a is _NODEFAULT for a in absorbed):
   326	            # An absorbed ``*Us`` whose TypeVarTuple stayed unbound (or a NoDefault
   327	            # member) leaves the run's length indeterminate, so the whole binding
   328	            # is unresolved -- not a concrete tuple that merely contains the hole.
   329	            subs[tvt] = _NODEFAULT
   330	        else:
   331	            subs[tvt] = absorbed
   332	    else:
   333	        # Bare (unsubscripted) class, or too few args: ``*Ts`` is unspecified, so
   334	        # treat it as unfilled (-> unresolved) rather than an empty binding,
   335	        # matching how a bare ``C[T]`` leaves ``T`` unresolved.
   336	        bind_unfilled(tvt)
   337	    for j in range(n_suffix):
   338	        p = params[tvt_idx + 1 + j]
   339	        if not bindable(p):
   340	            continue
   341	        arg_idx = tvt_idx + n_absorbed + j
   342	        bind_positional(p, args[arg_idx]) if arg_idx < len(args) else bind_unfilled(p)
   343	    return subs
   344	
