   346	def _resolve(
   347	    node: Any,
   348	    target_base: type,
   349	    parent_subs: dict[Any, Any],
   350	    return_bound_as_fallback: bool,
   351	) -> tuple[Any, ...] | None:
   352	    """DFS through ``node``'s inheritance hierarchy looking for ``target_base``.
   353	
   354	    ``parent_subs`` is the substitution map accumulated from outer levels and
   355	    is applied to ``node``'s args before computing this level's own
   356	    substitution map. When ``origin`` matches ``target_base`` we read the
   357	    target's own typevars out of the freshly-built map.
   358	    """
   359	    if is_generic_alias(node):
   360	        origin = get_origin_robust(node)
   361	        if origin is None:
   362	            return None
   363	        args = _subst_args(get_args_robust(node), parent_subs)
   364	        subscripted = True
   365	    elif isinstance(node, type):
   366	        origin = node
   367	        args = ()
   368	        subscripted = False
   369	    else:
   370	        return None
   371	
   372	    subs = _build_subs(origin, args, return_bound_as_fallback, subscripted)
   373	
   374	    if origin is target_base:
   375	        params = get_parameters(target_base)
   376	        # Builtin generics (list, dict, tuple, collections.abc.*, ...) don't
   377	        # expose their type parameters via __type_params__/__parameters__, so
   378	        # ``params`` is empty even though we arrived via e.g. ``list[list[T]]``.
   379	        # In that case fall back to the (already-substituted) args we walked to.
   380	        if not params and args:
   381	            return args
   382	        # ``subs.get(p, p)`` (not gated on ``_is_typevar``) so ``*Ts`` / ``**P``
   383	        # params resolve to their bound value too.
   384	        return tuple(subs.get(p, p) for p in params)
   385	
   386	    for base in get_original_bases(origin):
   387	        base_origin = get_origin_robust(base) if is_generic_alias(base) else base
   388	        if base_origin is typing.Generic:
   389	            continue
   390	        result = _resolve(base, target_base, subs, return_bound_as_fallback)
   391	        if result is not None:
   392	            return result
   393	    return None
   394	
