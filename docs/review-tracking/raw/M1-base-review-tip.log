    62	def _is_typevartuple(x: Any) -> bool:
    63	    """``*Ts`` -- a PEP 646 ``TypeVarTuple``. Not a ``TypeVar``; binds to a
    64	    *sequence* of types and appears in containers wrapped in ``Unpack[...]``."""
