    89	def coerce_to_type_form(value: Any) -> Any:
    90	    """Coerce a raw value into the type-domain form that subscription produces.
    91	
    92	    A typevar's ``__default__`` is stored in *source* form: ``T = None`` keeps
    93	    the ``None`` singleton and ``T = "Foo"`` keeps the bare string ``"Foo"``.
    94	    Type *subscription* normalizes those -- ``C[None]`` yields ``NoneType`` and
    95	    ``C["Foo"]`` yields ``ForwardRef('Foo')`` -- via ``typing._type_convert``.
    96	    Running a default through the same conversion keeps the default branch
    97	    (``C``) and the explicit branch (``C[default]``) byte-for-byte identical;
    98	    notably this is *conversion*, not evaluation, so (like subscription) it
    99	    leaves nested strings alone and never needs a namespace.
   100	
   101	    Falls back to a manual ``None -> NoneType`` if the private ``typing`` helper
   102	    ever disappears -- that being the one coercion paramsight actually relies on.
   103	    """
   104	    convert = getattr(typing, "_type_convert", None)
   105	    if convert is not None:
   106	        try:
   107	            return convert(value)
   108	        except Exception:
   109	            pass
   110	    return type(None) if value is None else value
   111	
