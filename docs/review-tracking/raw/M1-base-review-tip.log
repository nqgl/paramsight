   150	def _subst_args(args: tuple[Any, ...], subs: dict[Any, Any]) -> tuple[Any, ...]:
   151	    """Substitute a sequence of type arguments, flattening any ``*Ts`` whose
   152	    ``TypeVarTuple`` is bound to a tuple of types: ``tuple[int, *Ts, str]`` with
   153	    ``Ts = (a, b)`` yields ``(int, a, b, str)``. A still-unbound ``*Ts`` is left
   154	    in place (with its inner re-substituted) so it reads as unresolved."""
   155	    out: list[Any] = []
   156	    for a in args:
   157	        if _is_unpack(a):
   158	            inner = _unpack_inner(a)
   159	            if (
   160	                _is_typevartuple(inner)
   161	                and inner in subs
   162	                and subs[inner] is not _NODEFAULT
   163	            ):
   164	                out.extend(subs[inner])
   165	                continue
   166	        out.append(_substitute_typevars(a, subs))
   167	    return tuple(out)
   168	
   169	
   170	def _normalize_paramspec_arg(arg: Any, subs: dict[Any, Any]) -> Any:
   171	    """Normalize a ParamSpec binding to a parameter list. The arg can be a
   172	    tuple/list of types, a bare type (``C[int]`` shorthand for ``[int]``), ``...``,
   173	    or a forwarded ParamSpec; produce a tuple of substituted types (passing ``...``
   174	    or a ParamSpec straight through). The Callable branch turns the tuple into the
   175	    ``[p, ...]`` list form."""
   176	    if arg is Ellipsis or _is_paramspec(arg):
   177	        return arg
   178	    if isinstance(arg, (tuple, list)):
   179	        return tuple(_substitute_typevars(a, subs) for a in arg)
   180	    return (_substitute_typevars(arg, subs),)
   181	
   182	
   183	def _subst_concatenate(conc: Any, subs: dict[Any, Any]) -> Any:
   184	    """Substitute a ``Concatenate[t1, ..., P]`` Callable parameter spec: flatten any
   185	    ``*Ts`` in the prefix and expand the trailing ParamSpec. If that ParamSpec
   186	    resolved to a concrete parameter list the whole thing collapses to a flat list;
   187	    otherwise a Concatenate is rebuilt around the still-symbolic tail."""
   188	    *prefix, tail = get_args_robust(conc)
   189	    new_prefix = list(_subst_args(tuple(prefix), subs))
   190	    if _is_paramspec(tail):
   191	        tail_sub = subs.get(tail, tail)
   192	    else:
   193	        tail_sub = _substitute_typevars(tail, subs)
   194	    if isinstance(tail_sub, tuple):  # ParamSpec -> a concrete parameter list
   195	        return new_prefix + list(tail_sub)
   196	    if tail_sub is Ellipsis:
   197	        return Ellipsis
   198	    if _is_paramspec(tail_sub):  # still symbolic -> rebuild a Concatenate
   199	        return typing.Concatenate[tuple(new_prefix + [tail_sub])]
   200	    # The tail didn't resolve to a usable parameter list (e.g. an unbound
   201	    # ParamSpec -> NoDefault); Concatenate's last slot must be a ParamSpec or
   202	    # ``...``, so the whole spec is unresolved.
   203	    return _NODEFAULT
   204	
   205	
   206	def _typevartuple_default_members(
   207	    default: Any, subs: dict[Any, Any]
   208	) -> tuple[Any, ...] | None:
   209	    """The fixed members of a ``TypeVarTuple`` default (``*Ts = *tuple[int, str]``
   210	    -> ``(int, str)``), substituted against ``subs``. Returns None when the
   211	    default isn't a fixed-length unpacked tuple (e.g. an unbounded
   212	    ``*tuple[int, ...]``), which we can't expand into an absorbed run.
   213	
   214	    The ``*tuple[...]`` spelling stores the tuple alias directly; the
   215	    ``Unpack[tuple[...]]`` spelling wraps it -- unwrap that first."""
   216	    if _is_unpack(default):
   217	        default = _unpack_inner(default)
   218	    if typing.get_origin(default) is not tuple:
   219	        return None
   220	    members = get_args_robust(default)
   221	    if any(m is Ellipsis for m in members):
   222	        return None
   223	    # Coerce members the way subscription does (``None`` -> ``NoneType``,
   224	    # ``"Foo"`` -> ``ForwardRef``) so a fixed default matches the explicit
   225	    # specialization ``C[None, "Foo"]``, then resolve any typevars they reference.
   226	    return tuple(_substitute_typevars(coerce_to_type_form(m), subs) for m in members)
