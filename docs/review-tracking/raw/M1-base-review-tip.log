    91	    # Callable -- its args are ``([param, ...], ret)`` (or ``(Ellipsis, ret)`` /
    92	    # ``(ParamSpec, ret)``). The nested parameter list defeats both a flat walk
    93	    # and ``__class_getitem__``, so rebuild ``Callable[[params], ret]`` explicitly.
    94	    # ``get_args`` normalizes the ``typing.Callable`` and ``collections.abc.Callable``
    95	    # spellings to this same shape (only the former carries ``copy_with``).
    96	    if raw_origin is cabc.Callable:
    97	        params, ret = get_args_robust(value)
    98	        new_ret = _substitute_typevars(ret, subs)
    99	        if isinstance(params, list):
   100	            # ``[p, ...]`` -- substitute each, flattening any ``*Ts`` (PEP 646
   101	            # permits ``Callable[[int, *Ts], R]``).
   102	            new_params = list(_subst_args(tuple(params), subs))
   103	        elif typing.get_origin(params) is typing.Concatenate:
   104	            # ``Concatenate[t1, ..., P]`` -- flatten its prefix and expand its tail.
   105	            new_params = _subst_concatenate(params, subs)
   106	        elif _is_paramspec(params):
   107	            # A ParamSpec bound to a parameter list comes back as a tuple, which
   108	            # Callable wants in ``[p, ...]`` list form; an unbound one stays itself.
   109	            sub = subs.get(params, params)
   110	            new_params = list(sub) if isinstance(sub, tuple) else sub
   111	        else:
   112	            new_params = _substitute_typevars(params, subs)  # ``...``
   113	        if new_params is _NODEFAULT or new_ret is _NODEFAULT:
   114	            # An unresolved parameter list or return type can't be expressed as a
   115	            # Callable (``Callable[NoDefault, int]`` is invalid), so the whole
   116	            # form is unresolved.
   117	            return _NODEFAULT
   118	        if new_params == params and new_ret == ret:
   119	            return value
   120	        return cabc.Callable[new_params, new_ret]  # type: ignore[valid-type]
   121	
   122	    # Other typing special forms with a non-class origin (``Annotated``,
   123	    # ``ClassVar``, ``Final``, ``Literal``). They expose ``copy_with``, which
   124	    # rebuilds the form from its flat internal ``__args__``. ``get_origin_robust``
   125	    # asserts a class origin and would reject these, so handle them *before*
   126	    # falling through to it. Anything else parameterized is refused loudly.
   127	    if raw_origin is not None and not isinstance(raw_origin, type):
   128	        if not hasattr(value, "copy_with"):
   129	            _raise_unsupported_type_form(value, raw_origin)
   130	        internal = value.__args__
   131	        new_internal = tuple(_substitute_typevars(a, subs) for a in internal)
   132	        if new_internal == internal:
   133	            return value
   134	        return value.copy_with(new_internal)
   135	
   136	    # Plain class-based generics (``list[T]``, ``dict``, ``tuple``, ``type``, user
   137	    # generics) and pydantic models -- reconstruct through ``origin[...]``;
   138	    # ``get_args_robust`` / ``get_origin_robust`` carry the pydantic special-case.
   139	    origin = get_origin_robust(value)
   140	    if origin is None:
   141	        return value
   142	    args = get_args_robust(value)
   143	    new_args = _subst_args(args, subs)
   144	    if new_args == args:
   145	        return value
   146	    subscript = new_args[0] if len(new_args) == 1 else new_args
   147	    return origin.__class_getitem__(subscript)  # type: ignore[attr-defined]
   148	
