    64	    # members (``int | int`` -> ``int``). A free typevar member is fine, but the
    65	    # ``NoDefault`` sentinel isn't a type and can't be ``|``-ed, so a union with an
    66	    # unresolved member is itself unresolved.
    67	    if isinstance(value, UnionType) or raw_origin in (typing.Union, UnionType):
    68	        args = get_args_robust(value)
    69	        new_args = tuple(_substitute_typevars(a, subs) for a in args)
    70	        if new_args == args:
    71	            return value
    72	        if any(a is _NODEFAULT for a in new_args):
    73	            return _NODEFAULT
