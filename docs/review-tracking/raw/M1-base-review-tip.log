   396	@cache
   397	def get_args_at_base(
   398	    cls: type | GenericAlias,
   399	    target_base: type,
   400	    return_bound_as_fallback: bool = False,
   401	) -> tuple[type | GenericAlias | None, ...]:
   402	    """Resolve ``target_base``'s type parameters as seen from ``cls``.
   403	
   404	    Like :func:`typing.get_args`, but evaluated at an ancestor base anywhere
   405	    in ``cls``'s inheritance hierarchy rather than only at the immediate
   406	    generic alias. Returns one entry per typevar of ``target_base``.
   407	    """
   408	    result = _resolve(cls, target_base, {}, return_bound_as_fallback)
   409	    if result is None:
   410	        raise ValueError(
   411	            f"failed to locate target base {target_base!r} in hierarchy of {cls!r}"
   412	        )
   413	    return result
