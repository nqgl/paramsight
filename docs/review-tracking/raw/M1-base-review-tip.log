    76	    # Annotated -- ``Annotated[X, *meta]`` reports its *underlying type* ``X`` as
    77	    # ``typing.get_origin`` (a class), so the non-class special-form branch below
    78	    # misses it; and ``copy_with`` would keep ``__metadata__`` verbatim anyway.
    79	    # Substitute the underlying type *and* each metadata element -- a metadata
    80	    # item may itself reference a typevar (``class M[T](B[Annotated[int, T]])``) --
    81	    # then rebuild. ``__metadata__`` uniquely identifies an ``Annotated`` alias.
    82	    if hasattr(value, "__metadata__"):
    83	        base = value.__origin__
    84	        meta = value.__metadata__
