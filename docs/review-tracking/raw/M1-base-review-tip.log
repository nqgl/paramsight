    68	def _is_paramspec(x: Any) -> bool:
    69	    """``**P`` -- a PEP 612 ``ParamSpec``. Not a ``TypeVar``; binds to a parameter
    70	    list and appears as the first argument of a ``Callable``."""
    71	    return isinstance(x, typing.ParamSpec)
