     # opt-in means we fall back silently (rather than raising) for the miss.
     assert attrs.evolve(inst, x=2).get_type() != (int,)
     assert copy.copy(inst).get_type() != (int,)
     assert copy.deepcopy(inst).get_type() != (int,)
 
 
