     """Documented limitation of side_table: fresh instances aren't in the
     table. (Declare ``__orig_class__`` yourself if you need evolve/copy/pickle
     preservation.)"""
     inst = SideTableBox[int](x=1)
     assert inst.get_type() == (int,)
